# Orclaw configuration — copy to /etc/orclaw/secrets.env on the VM
# or to ./.env for local dev.
#
# Anything prefixed ORCLAW_ overrides the equivalent in settings.toml.
# Secrets (tokens) live ONLY here, never in settings.toml.

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# The repo Orclaw will orchestrate. Format: owner/name.
ORCLAW_GITHUB_REPO=yourname/your-target-repo

# Personal Access Token with 'repo' scope (classic) or fine-grained PAT
# with: contents:write, issues:write, pull-requests:write, actions:read.
# Used to read issues, post comments, manage labels, query PRs.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# CONCURRENCY
# -----------------------------------------------------------------------------

# Max parallel @claude dispatches in flight. Each one consumes one slot of
# your Pro plan's 5h window (~45 messages). Start with 2, raise once you see
# steady-state behavior. The dashboard's "tuning" page can override this
# at runtime without a restart.
ORCLAW_CONCURRENCY_MAX_IN_FLIGHT=2
ORCLAW_CONCURRENCY_DEFAULT_IN_FLIGHT=2

# -----------------------------------------------------------------------------
# TELEGRAM (optional but recommended)
# -----------------------------------------------------------------------------

# Create a bot via @BotFather, paste the token here.
ORCLAW_TELEGRAM_BOT_TOKEN=

# Your numeric chat ID. Get it by messaging @userinfobot.
# Bot will refuse commands from any other chat for safety.
ORCLAW_TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# HEALTHCHECKS.IO (optional)
# -----------------------------------------------------------------------------

# Ping URLs for "is the orchestrator alive?" monitoring. See healthchecks.io.
ORCLAW_HEALTHCHECKS_ORCHESTRATOR_URL=
ORCLAW_HEALTHCHECKS_PLANNER_URL=

# -----------------------------------------------------------------------------
# PATHS (defaults are fine — override only if you know why)
# -----------------------------------------------------------------------------

ORCLAW_DATA_DIR=/var/lib/orclaw
ORCLAW_DB_PATH=/var/lib/orclaw/orclaw.db

# -----------------------------------------------------------------------------
# LOGGING + DEBUG
# -----------------------------------------------------------------------------

ORCLAW_LOG_LEVEL=INFO
# Set to 1 to mirror structured logs to the SQLite events table (recommended).
ORCLAW_EVENTS_TO_DB=1

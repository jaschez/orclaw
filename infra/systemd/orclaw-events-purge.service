[Unit]
Description=Orclaw — purge events older than 30 days
After=network-online.target

[Service]
Type=oneshot
User=engine
Group=engine
WorkingDirectory=/opt/orclaw
EnvironmentFile=/etc/orclaw/secrets.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/orclaw/.venv/bin/orclaw events purge --older-than 30
StandardOutput=journal
StandardError=journal

TimeoutStartSec=60

ProtectSystem=strict
ReadWritePaths=/var/lib/orclaw /tmp
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
